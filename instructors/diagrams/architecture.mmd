graph TB
    subgraph Browser["Browser"]
        Views["Razor Views<br/>(Html.* helpers)"]
        JS["notifications.js<br/>(polling every 5s)"]
        Bundles["jQuery 3.7.1 + Bootstrap 5.3.3<br/>(System.Web.Optimization bundles)"]
    end

    subgraph IIS["IIS Express / .NET Framework 4.8"]
        Global["Global.asax.cs<br/>MvcApplication : HttpApplication"]
        
        subgraph AppStart["App_Start"]
            RouteConfig["RouteConfig.cs"]
            BundleConfig["BundleConfig.cs"]
            FilterConfig["FilterConfig.cs"]
        end
        
        subgraph Controllers["Controllers (ASP.NET MVC 5)"]
            Base["BaseController<br/>- SchoolContext db<br/>- NotificationService"]
            Home["HomeController"]
            Students["StudentsController"]
            Courses["CoursesController"]
            Instructors["InstructorsController"]
            Departments["DepartmentsController"]
            Notifications["NotificationsController"]
        end

        subgraph Services["Services"]
            NotifSvc["NotificationService<br/>- MSMQ primary<br/>- ConcurrentQueue fallback"]
        end

        subgraph Data["Data Layer"]
            Factory["SchoolContextFactory<br/>(manual DbContext creation)"]
            Context["SchoolContext : DbContext<br/>(EF Core 3.1.32)"]
            Initializer["DbInitializer<br/>(EnsureCreated + seed)"]
        end
    end

    subgraph External["External Dependencies"]
        MSMQ["MSMQ<br/>.\Private$\ContosoUniversityNotifications"]
        LocalDB["SQL Server LocalDB<br/>ContosoUniversityNoAuthEFCore"]
        FileSystem["Local File System<br/>~/Uploads/TeachingMaterials/"]
    end

    Views --> Controllers
    JS -->|"GET /Notifications/GetNotifications"| Notifications
    Global --> AppStart
    Global --> Initializer
    Base --> Factory
    Factory --> Context
    Base --> NotifSvc
    Controllers --> Context
    NotifSvc --> MSMQ
    Context --> LocalDB
    Courses -->|"Server.MapPath + SaveAs"| FileSystem
    Home --> Base
    Students --> Base
    Courses --> Base
    Instructors --> Base
    Departments --> Base
    Notifications --> Base
